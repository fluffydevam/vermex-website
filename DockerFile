# Use official PHP 8.1 image with Apache
FROM php:8.1-apache

# Install required system packages, CA certificates, and PHP extensions
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    zip \
    unzip \
    git \
    ca-certificates \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo_mysql gd

# Enable Apache mod_rewrite for routing/permalinks
RUN a2enmod rewrite

# Copy your application files into the container web root
COPY . /var/www/html/

# Set correct ownership for Apache web server files
RUN chown -R www-data:www-data /var/www/html

# Render requires applications to listen on the dynamic $PORT environment variable (default: 10000)
ENV PORT=10000
RUN sed -i -e 's/80/${PORT}/g' /etc/apache2/sites-available/000-default.conf \
    && sed -i -e 's/80/${PORT}/g' /etc/apache2/ports.conf

# Expose the dynamic port
EXPOSE 10000

# Start Apache in the foreground
CMD ["apache2-foreground"]